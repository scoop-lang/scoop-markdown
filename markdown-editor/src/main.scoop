package scoop.examples.markdown.editor

import scoop.concurrent.multiThreadExecutor
import scoop.platform.process.command
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.markdown.*
import scoop.window.*

fun main(args: Array<String>) {
    try {
        runEditor(args)
    } catch (error: Throwable) {
        editorPrintFailure(error)
        exit(1)
    }
}

private fun runEditor(args: Array<String>) {
    val options = editorLaunchOptions(args)
    if (options.help) {
        println(
            "Usage: markdown-editor [markdown-file] [--mermaid <mmdc>] [--mathjax <node> <@mathjax/src> <rsvg-convert>]"
        )
        return
    }
    val renderers = ArrayList<MarkdownImageRenderer>()
    renderers.add(MarkdownFileImageRenderer())
    when (options.mermaid) {
        case Some(val path) -> renderers.add(
            MarkdownMermaidImageRenderer(command(path), "configured-mmdc")
        )
        case None -> Unit
    }
    when (options.mathjax) {
        case Some(val paths) -> {
            val(node, source, converter) = paths
            renderers.add(
                MarkdownMathJaxImageRenderer(
                    command(node),
                    source,
                    command(converter),
                    "configured-mathjax-rsvg"
                )
            )
        }
        case None -> Unit
    }
    multiThreadExecutor {
        workers = 1
        blocking { threads = 1 }
    }.use {
        workers -> EditorApplication(workers, renderers, options.file).use {
            documents -> context(ThemeSource(editorTheme())) {
                val application =
                    Application(
                        applicationOptions {
                            applicationId = Some("org.scoop.examples.markdown-editor")
                            lastWindowPolicy = editorLastWindowPolicy()
                        }
                    )
                UiHost(
                    onRootError = { _, error -> documents.fail(error) },
                    onApplicationError = { error -> documents.fail(error) }
                ) {
                    host,
                    active,
                    event -> try {
                        documents.event(host, active, event)
                    } catch (error: Throwable) {
                        documents.fail(error)
                    }
                }.use {
                    host ->
                    application.run(host)
                    documents.rethrowFailure()
                }
            }
        }
    }
}
