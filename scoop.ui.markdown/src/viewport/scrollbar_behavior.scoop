package scoop.ui.markdown

import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.surface.*
import scoop.time.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.window.*

/** Resolves the same public behavior and system facts used by UI text controls. */
internal class MdScrollbarBehavior(
    val input: ScrollbarBehavior,
    preferences: InteractionPreferences,
    reduced: Boolean
) {
    private val automatic =
        when (input.preset) {
            case FollowSystem -> preferences.autoHideScrollbars ?: false
            case Static -> false
            case Custom -> true
        }
    val autoHide = input.autoHide ?: automatic
    val reducedMotion = reduced || (preferences.reduceMotion ?: false)
    val opaque = preferences.reduceTransparency ?: false
    val idleWidth =
        input.idleWidth ?:
            if (automatic)
                6.0
            else
                12.0
    val hoverWidth =
        if (input.widenOnHover ?: automatic)
            input.hoverWidth ?: 12.0
        else
            idleWidth
    val dragWidth =
        if (input.widenOnHover ?: automatic)
            input.dragWidth ?: 12.0
        else
            idleWidth
    val idleOpacity =
        if (opaque)
            1.0
        else
            input.idleOpacity ?:
                if (automatic)
                    0.55
                else
                    1.0
    val hoverOpacity =
        if (opaque)
            1.0
        else
            if (input.shadeOnHover ?: automatic)
                input.hoverOpacity ?:
                    if (automatic)
                        0.85
                    else
                        1.0
            else
                idleOpacity
    val dragOpacity =
        if (opaque)
            1.0
        else
            if (input.shadeOnHover ?: automatic)
                input.dragOpacity ?: 1.0
            else
                idleOpacity
    val thickness =
        max(max(idleWidth, max(hoverWidth, dragWidth)), input.minimumHitThickness ?: 12.0)
    val edgeThickness = input.edgeThickness ?: thickness
    val showTrack = input.showTrack ?: !automatic

    fun animate(
        value: Animatable<Double>,
        target: Double,
        duration: Duration,
        opacity: Boolean = false
    ) {
        if (reducedMotion || (opacity && opaque) || duration == Duration.ZERO) {
            if (value.value != target || value.target != target)
                value.snapTo(target)
        } else
            if (value.target != target)
                value.animateTo(target, AnimationSpec.Tween(duration))
    }

    fun viewport(size: Size, axes: ScrollAxes, direction: LayoutDirection): Rect {
        val reserved = input.placement == ScrollbarPlacement.Gutter
        val x =
            if (reserved && axes.vertical)
                min(thickness, size.width)
            else
                0.0
        val y =
            if (reserved && axes.horizontal)
                min(thickness, size.height)
            else
                0.0
        return Rect(
            if (direction == LayoutDirection.Rtl)
                x
            else
                0.0,
            0.0,
            size.width - x,
            size.height - y
        )
    }
}
