package scoop.ui.markdown

import scoop.markdown.*
import scoop.platform.system.*
import scoop.ui.text.*
import scoop.window.*

/** A native source completion may remove only this unchanged source selection. */
internal class MdTextTransfer(
    val target: MdTextTarget,
    val editor: MarkdownEditorState,
    val snapshot: MarkdownSnapshot,
    val selection: MarkdownSelection,
    val content: MdTextExport,
    val effects: DragEffects,
    val completed: (TextDragResult) -> Unit
) {
    var moved = false
    val canMove: Boolean get() =
        !moved &&
            effects.move &&
            target.scope.isMounted &&
            target.enabled &&
            !target.readOnly &&
            target.options.drag.enabled &&
            target.options.drag.effects.move &&
            target.options.drag.copyPolicy !=
            TextCopyPolicy.Deny &&
            target.editor ===
            editor &&
            !editor.isClosed &&
            editor.snapshot ===
            snapshot &&
            editor.selection ==
            selection &&
            !editor.isComposing
}

internal fun mdDropSource(data: Any?): MdTextTransfer? =
    when (data) {
        case Some(val value) -> value as? MdTextTransfer
        case None -> None
    }

internal fun mdDropEffect(offer: DropOffer, source: MdTextTransfer?): DragEffect? {
    val moving = offer.effects.move && (source?.canMove ?: true)
    val copy =
        if (operatingSystem == OperatingSystem.Darwin)
            offer.modifiers.alt
        else
            offer.modifiers.control
    return if (moving && !(copy && offer.effects.copy))
        Some(DragEffect.Move)
    else
        if (offer.effects.copy)
            Some(DragEffect.Copy)
        else
            None
}

internal struct MdSourceMoveEdit(val change: MarkdownChange, val selection: MarkdownRange)

internal fun mdSourceMoveSelection(
    snapshot: MarkdownSnapshot,
    range: MarkdownRange,
    position: MarkdownPosition
): MdSourceMoveEdit {
    val at = position.byteOffset
    snapshot.read(MarkdownRange(at, at))
    val text = snapshot.read(range)
    if (range.isEmpty || (at >= range.start && at <= range.end))
        return MdSourceMoveEdit(snapshot.prepare(MarkdownEdit(snapshot.revision, [])), range)
    val deletion = MarkdownReplacement(range, "")
    val insertion = MarkdownReplacement(MarkdownRange(at, at), text)
    val change =
        snapshot.prepare(
            MarkdownEdit(
                snapshot.revision,
                if (at < range.start)
                    [insertion, deletion]
                else
                    [deletion, insertion]
            )
        )
    val start =
        if (at < range.start)
            at
        else
            at - range.byteLength
    return MdSourceMoveEdit(change, MarkdownRange(start, start + text.byteLength))
}

internal fun mdCompleteTextTransfer(source: MdTextTransfer, result: DragResult) {
    val completed =
        when (result) {
            case Dropped(DragEffect.Move) -> {
                if (source.moved)
                    TextDragResult.Moved
                else
                    if (source.canMove && source.target.replace(source.selection.range, ""))
                        TextDragResult.Moved
                    else
                        TextDragResult.SourceRetained
            }
            case Dropped(DragEffect.Copy) -> TextDragResult.Copied
            case Dropped(DragEffect.Link) -> TextDragResult.NotDropped
            case NotDropped -> TextDragResult.NotDropped
            case Failed(val error) -> TextDragResult.Failed(error)
        }
    source.completed(completed)
}
